# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI APIs ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Meta Ads ──────────────────────────────────────────────────────────────────
# Obtén estos valores en: https://developers.facebook.com/apps/
META_APP_ID=
META_APP_SECRET=              # NUNCA exponer al cliente; solo usar en server actions / API routes
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
META_TOKEN_SECRET=            # Mínimo 32 caracteres; usado para cifrar tokens con AES-256-GCM

# Versión de la Graph API (default: v21.0 si no se define)
META_API_VERSION=v21.0

# Facebook Login for Business — opcional (recomendado para SaaS/Tech Providers)
# Crear en: App Dashboard → Facebook Login for Business → Configurations
# Cuando está definido, el flujo OAuth usa config_id en lugar de scopes individuales
META_CONFIG_ID=

# Modo prueba: muestra badge visual "Modo prueba" en la UI pero no afecta las llamadas a Meta
META_DRY_RUN=false

# Kill switch de publicación — solo activar después de validar el publisher completamente
# MANTENER EN false DURANTE DESARROLLO Y PRUEBAS
META_PUBLISH_ENABLED=false

# ── Stripe (future) ───────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
